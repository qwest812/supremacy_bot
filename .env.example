# ── Доступ к игре ─────────────────────────────────────────────────────────
# Ник или почта и пароль от Supremacy 1914. Аккаунт, привязанный только
# к входу через Google, не подойдёт: боту нечем в него войти.
S1914_USER=
S1914_PASSWORD=
# Языковой раздел лобби: в ru и en висят разные партии.
S1914_LANG=ru

# ── Какую партию играть ───────────────────────────────────────────────────
# Номер партии (виден в адресе игры). Пусто — бот возьмёт единственную
# вашу идущую партию под фильтр ниже.
GAME_ID=
# Фильтр партий: часть названия и скорость. Его же использует -lobby.
LOBBY_TITLE=Europe
LOBBY_SPEED=4

# ── Режим ─────────────────────────────────────────────────────────────────
# true — бот заходит в партию и пишет в журнал, что сделал бы, но ничего
# не отправляет. Начинайте с него и сверяйте решения с журналом.
DRY_RUN=true

# Пауза между заходами: бот приходит к ближайшему событию (стройка,
# ресурсы, смена дня), но не чаще VISIT_MIN и не реже VISIT_MAX.
# Заход игра засчитывает как вход в партию — слишком часто не надо.
VISIT_MIN=4m
VISIT_MAX=25m
# Сколько кругов решений в одном заходе (быстрые стройки в x4).
VISIT_ROUNDS=3
# Пауза между приказами.
ACTION_PAUSE=2s

# Куда писать журналы и память партий.
LOG_DIR=logs
DATA_DIR=data

# ── Правила стройки ───────────────────────────────────────────────────────
# Казармы выключаются, когда зерна меньше RULE_FOOD_LOW и оно тает,
# и включаются, когда больше RULE_FOOD_OK.
RULE_FOOD_LOW=3000
RULE_FOOD_OK=8000
RULE_HARBOUR_DAY=2
RULE_RAILWAY_DAY=3
# С какого дня откладывать ресурсы на фабрику.
RULE_FACTORY_RESERVE_DAY=5
# Сколько денег не трогать при стройке железных дорог.
RULE_MONEY_KEEP=5000

# ── Торговля ──────────────────────────────────────────────────────────────
TRADE=true
# Излишек сначала идёт на обмен. За деньги (ботам, по TRADE_RATE за единицу)
# продаём только то, что лежит сверх TRADE_KEEP_STOCK + TRADE_SELL_ABOVE.
# На бирже бот не продаёт никогда: там теряется 20%.
TRADE_RATE=10
TRADE_SELL_ABOVE=8000
TRADE_CHUNK=2000
TRADE_OFFERS_PER_VISIT=2
# Сколько каждого ресурса оставлять себе.
TRADE_KEEP_STOCK=3000
# Покупать на бирже не дороже справочной цены × TRADE_BUY_MARKUP.
TRADE_BUY_MARKUP=1.2
# Принимать предложения, где получаем по справочным ценам в столько раз больше.
TRADE_ACCEPT_RATIO=1.2
# Дефицит: в начале партии на всей карте мало руды и дерева, с
# TRADE_OIL_FROM_DAY — нефти. Их держим не меньше TRADE_STRATEGIC_STOCK и
# докупаем впрок, когда на бирже не дороже справочной × TRADE_CHEAP_MARKUP.
TRADE_STRATEGIC_STOCK=5000
TRADE_OIL_FROM_DAY=6
TRADE_CHEAP_MARKUP=1.0
# Ресурс с отрицательным приростом, который кончится за столько суток, — дефицит.
TRADE_FORECAST_DAYS=2
# В обмене отдаём по справочным ценам в столько раз больше, чем просим.
TRADE_SWAP_RATIO=1.1
# Предлагать обмен и живым игрокам, а не только ботам.
TRADE_WITH_HUMANS=true

# ── Дипломатия ────────────────────────────────────────────────────────────
RIGHT_OF_WAY_TO_BOTS=true

# ── Война ─────────────────────────────────────────────────────────────────
# Оборона работает всегда. WAR=true — бот сам объявляет войну ботам-соседям
# и берёт их провинции (одна война за раз). Людям войну не объявляет, если
# не включить WAR_ON_HUMANS; с людьми воюет, только если они начали.
WAR=true
WAR_ON_HUMANS=false
WAR_FROM_DAY=3
# Сила — оценка самой игры: пехотинец 4.5, бронеавтомобиль 9, кавалерия 11.
# Новую войну начинаем, когда свободных сил хотя бы столько.
WAR_MIN_POWER=60
# Нападаем, только если сильнее врага в ATTACK_RATIO раз; против угрозы
# держим DEFENSE_RATIO от её силы; гарнизон уводим, если враг сильнее его
# в RETREAT_RATIO раз (столицу не бросаем никогда).
ATTACK_RATIO=1.5
DEFENSE_RATIO=1.2
RETREAT_RATIO=2.5
# Газета: на старте в каждой провинции START_GARRISON пехоты. Кто потерял
# по газете WAR_WEAK_SHARE своей стартовой армии и больше — ослаб: на него
# можно напасть и до WAR_FROM_DAY, а его оценка как цели растёт
# в 1 + WAR_WEAK_BONUS × доля потерь раз.
START_GARRISON=10
WAR_WEAK_SHARE=0.3
WAR_WEAK_BONUS=2
# Бить одним стаком: армии из разных мест сначала сводятся в нашу
# провинцию у цели (там сливаются), и атакуют уже оттуда.
WAR_STACKS=true
# На сколько провинций тянуться за армиями для захвата и для обороны.
STRIKE_HOPS=5
DEFEND_HOPS=6
MAX_ATTACKS_PER_VISIT=3

# ── Интерфейс ─────────────────────────────────────────────────────────────
# Веб-интерфейс к журналам и карте поднимается вместе с ботом.
# Открывать: http://127.0.0.1:8090. Пусто — не поднимать.
UI_ADDR=127.0.0.1:8090
